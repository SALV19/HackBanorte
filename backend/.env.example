MONGO_URI=mongodb+srv://USUARIO:CONTRASENA@TU_CLUSTER.mongodb.net/
MONGO_DB_NAME=hackbanorte
DOCUMENTS_VECTOR_INDEX=document_embedding
DOCUMENTS_VECTOR_PATH=content
PORT=3000

# Gemini: la clave y el modelo deben tener cuota disponible.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Alternativa local: cambia LLM_PROVIDER a ollama y ejecuta el modelo instalado.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:1b

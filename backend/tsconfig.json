{
  "compilerOptions": {
    // File Layout
    // "rootDir": "./src",   // déjalo comentado, tu proyecto es flat (sin src/)
    "outDir": "./dist",      // descomenta esta, la vas a necesitar para "build"

    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],       // <- antes estaba [], así no carga @types/node

    "esModuleInterop": true, // <- nueva, necesaria para imports de express, etc.

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // "noUncheckedIndexedAccess": true,
    // "exactOptionalPropertyTypes": true,

    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  }
}
{
  "compilerOptions": {
    // File Layout
    // "rootDir": "./src",   // déjalo comentado, tu proyecto es flat (sin src/)

    // outDir/declaration/declarationMap se quitaron a propósito: con
    // "@hackbanorte/catalog" resuelto por "paths" a un .ts fuera de esta
    // carpeta, tsc exige que TODOS los archivos del programa vivan bajo un
    // único rootDir para poder calcular el output (TS6059) — y catalog/ está
    // fuera por diseño (es un workspace hermano). El dev real corre con tsx
    // (no le importa outDir), así que quitar esto no afecta nada que se use
    // hoy. Si en algún momento hace falta un build real a dist/, hay que
    // resolverlo con Project References o empaquetando catalog/ dentro del
    // build de backend — por ahora "npm run build"/"npm start" (dist/) no
    // sirven, avisar antes de intentar usarlos.

    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],       // <- antes estaba [], así no carga @types/node

    "esModuleInterop": true, // <- nueva, necesaria para imports de express, etc.

    "sourceMap": true,

    // "noUncheckedIndexedAccess": true,
    // "exactOptionalPropertyTypes": true,

    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    "paths": {
      "@hackbanorte/catalog": ["../catalog/index.ts"],
      "@hackbanorte/catalog/*": ["../catalog/*"]
    },
  }
}
